# Use a dedicated authenticated Robinhood Chain mainnet RPC.
ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_ME

# Production deployment only. Never commit the real value.
DEPLOYER_PRIVATE_KEY=0xREPLACE_ME

# A deployed Safe with exactly 3 owners and threshold 2.
GIVEXA_SAFE=0xREPLACE_ME

# Fee destination. This may be the same Safe.
GIVEXA_TREASURY=0xREPLACE_ME

# SHA-256 of deployments/robinhood-mainnet.assets.json after same-day RHJ API verification.
OFFICIAL_ASSET_MANIFEST_HASH=0xREPLACE_ME
