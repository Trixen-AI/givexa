# Every VITE_ value is bundled into the browser. Never put a private key or secret here.

# Required. Public Reown Cloud project ID used by the wallet connect modal (Robinhood Chain).
# Add latentiaapp.org (and your Vercel preview domain) to the project's allowed domains in Reown Cloud.
VITE_REOWN_PROJECT_ID=

# Required. Browser-safe Robinhood Chain RPC endpoint. Apply origin restrictions in the provider dashboard.
VITE_ROBINHOOD_RPC_URL=

# Canonical production origin used in Reown metadata and generated claim links.
VITE_PUBLIC_APP_URL=https://latentiaapp.org
