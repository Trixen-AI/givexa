# Every VITE_ value is bundled into the browser. Never put a private key or secret here.

# Required. Public Reown Cloud project ID used by the Solana wallet connect modal.
# Add givexa.xyz (and your Vercel preview domain) to the project's allowed domains in Reown Cloud.
VITE_REOWN_PROJECT_ID=

# Required. Browser-safe RPC endpoint the app uses to read the existing Gift Vault contracts.
# The contracts are unchanged, so this must stay a Robinhood Chain RPC. Apply origin restrictions.
VITE_ROBINHOOD_RPC_URL=

# Optional. Solana mainnet RPC for the wallet modal (balances, signing). Leave empty to use Reown's default.
VITE_SOLANA_RPC_URL=

# Canonical production origin used in Reown metadata and generated claim links.
VITE_PUBLIC_APP_URL=https://givexa.xyz
